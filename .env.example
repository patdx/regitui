# Copy to .env and fill in values for your machine.
# .env is gitignored — never commit personal printer/store names.

# CUPS destination for the in-app F / CTRL-P key (lp -d NAME).
# Leave unset to use the system default printer.
# REGITUI_PRINTER=OfficePrinter

# Store name printed at the top of the receipt (default: MY SHOP).
# REGITUI_STORE=MY SHOP

# Paper size for F: a4, letter, a3, legal (default: a4).
# REGITUI_PRINT_PAPER=a4

# Override the whole print pipeline (also used by the test suite).
# REGITUI_PRINT_CMD=cat > /dev/null
